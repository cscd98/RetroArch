   strtod strtol strtoul rand srand malloc calloc realloc
   free memalign aligned_alloc memcpy memmove memset memcmp
   memchr strlen strcmp strncmp strcpy stpcpy strncpy strcat strncat
   strchr strrchr strstr strspn strcspn strpbrk strtok strerror
   strdup strndup strcasecmp strncasecmp qsort bsearch getenv putenv
   setenv unsetenv atexit exit fopen freopen fclose fflush
   fread fwrite fseek ftell rewind fgetpos fsetpos feof
   ferror clearerr fileno setbuf setvbuf printf fprintf sprintf
   snprintf vprintf vfprintf vsprintf vsnprintf scanf fscanf sscanf
   vscanf vfscanf vsscanf fgetc getc getchar fgets fputc
   putc putchar fputs puts ungetc remove rename tmpfile
   tmpnam perror open close read write lseek fstat
   stat unlink access mkdir rmdir getcwd chdir opendir
   readdir closedir rewinddir time clock difftime mktime localtime
   gmtime strftime asctime ctime gettimeofday nanosleep usleep sleep
   isalnum isalpha iscntrl isdigit isgraph islower isprint ispunct
   isspace isupper isxdigit tolower toupper setlocale localeconv mblen
   mbtowc wctomb mbstowcs wcstombs mbrtowc wcrtomb mbsrtowcs wcsrtombs
   wcslen wcscmp wcscpy wmemcpy wmemmove wmemset wmemcmp __cxa_atexit
   __cxa_finalize __cxa_guard_acquire __cxa_guard_release __getreent acos asin atan atan2
   ceil cos cosh exp fabs floor fmod frexp
   ldexp log log10 modf pow sin sinh sqrt
   tan tanh copysign exp2 expm1 log1p log2 hypot
   round trunc nearbyint rint fmin fmax fma acosf
   asinf atanf atan2f ceilf cosf coshf expf fabsf
   floorf fmodf frexpf ldexpf logf log10f modff powf
   sinf sinhf sqrtf tanf tanhf copysignf exp2f expm1f
   log1pf log2f hypotf roundf truncf nearbyintf rintf fminf
   fmaxf fmaf acosl asinl atanl atan2l ceill cosl
